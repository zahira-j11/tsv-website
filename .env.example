# Copy to .env.local and replace every placeholder. These are not real secrets.
# .env.local is gitignored.

# Public site URL used in metadata. Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.thesocialvision.co.uk

# GA4 measurement ID. Leave empty to disable Google Analytics.
NEXT_PUBLIC_GA_ID=

# HubSpot portal ID. Leave empty to disable HubSpot tracking.
# When unset, the site falls back to the portal id already in the tracker code.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# MongoDB connection string for audit applications and reels.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Shared password for /admin/applications.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Signs the admin session cookie. Must be different from AUDIT_WEBHOOK_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Existing webhook secret. Not used to sign admin sessions.
AUDIT_WEBHOOK_SECRET=replace-with-the-existing-webhook-secret
